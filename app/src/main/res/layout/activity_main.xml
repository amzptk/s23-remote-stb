<?xml version="1.0" encoding="utf-8"?>
<!-- Dark remote layout. All buttons are large and reachable one-handed.
     IDs are wired up in MainActivity.java. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:padding="12dp"
            android:text="@string/status_not_ready"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/scanButton"
                style="@style/RemoteButton.Accent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/scan" />

            <Button
                android:id="@+id/connectButton"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/connect" />

            <Button
                android:id="@+id/disconnectButton"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/disconnect" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/select_device_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:background="@color/surface" />

        <!-- D-pad: Up / Left-OK-Right / Down -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnUp"
                style="@style/RemoteButton"
                android:layout_width="96dp"
                android:layout_height="64dp"
                android:text="▲" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLeft"
                    style="@style/RemoteButton"
                    android:layout_width="96dp"
                    android:layout_height="64dp"
                    android:text="◀" />

                <Button
                    android:id="@+id/btnOk"
                    style="@style/RemoteButton.Accent"
                    android:layout_width="96dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/ok" />

                <Button
                    android:id="@+id/btnRight"
                    style="@style/RemoteButton"
                    android:layout_width="96dp"
                    android:layout_height="64dp"
                    android:text="▶" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDown"
                style="@style/RemoteButton"
                android:layout_width="96dp"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:text="▼" />
        </LinearLayout>

        <!-- Back / Home / Menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/back" />

            <Button
                android:id="@+id/btnHome"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/home" />

            <Button
                android:id="@+id/btnMenu"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/menu" />
        </LinearLayout>

        <!-- Volume / Mute / Play-Pause -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVolDown"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vol_down" />

            <Button
                android:id="@+id/btnMute"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/mute" />

            <Button
                android:id="@+id/btnVolUp"
                style="@style/RemoteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/vol_up" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPlayPause"
            style="@style/RemoteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/play_pause" />

        <!-- Type text to the STB -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/inputText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/surface"
                android:hint="@string/type_text_hint"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <Button
                android:id="@+id/sendTextButton"
                style="@style/RemoteButton.Accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/send" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
