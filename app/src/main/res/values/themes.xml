<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme for the remote. AppCompat is the only dependency, so the
         theme extends Theme.AppCompat (no Material Components dependency). -->
    <style name="Theme.S23RemoteSTB" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="RemoteButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@color/surface_light</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="RemoteButton.Accent" parent="RemoteButton">
        <item name="android:background">@color/accent</item>
    </style>
</resources>
