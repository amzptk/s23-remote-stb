# Gradle start-up script for POSIX generated by Gradle.
# NOTE: this project ships the wrapper script and
# gradle/wrapper/gradle-wrapper.properties (Gradle 8.2) only.
# gradle/wrapper/gradle-wrapper.jar is a binary and is NOT included in
# this source-only tree; Android Studio supplies / downloads it on first
# build, or use a local Gradle 8.2 installation instead.

APP_NAME="Gradle"
APP_BASE_NAME=`basename "$0"`

# Resolve the location of the gradle installation.
GRADLE_HOME="${GRADLE_HOME:-$HOME/.gradle/wrapper/dists/gradle-8.2-bin}"

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
        echo "Please set the JAVA_HOME variable in your environment to match the" >&2
        echo "location of your Java installation." >&2
        exit 1
    fi
else
    JAVACMD="java"
    which java >/dev/null 2>&1 || { echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2; echo "Please install JDK 17 and set JAVA_HOME, or open this project in Android Studio." >&2; exit 1; }
fi

# Find the wrapper jar (supplied by Android Studio on first sync).
WRAPPER_JAR="$(dirname "$0")/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ]; then
    echo "gradle-wrapper.jar is missing. Open this project in Android Studio" >&2
    echo "(it will download the Gradle 8.2 wrapper) or install Gradle 8.2" >&2
    echo "and run 'gradle assembleDebug' instead of './gradlew'." >&2
    exit 1
fi

CLASSPATH="$WRAPPER_JAR"

exec "$JAVACMD" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
